# Earth Mission Control provider: ollama (default) | bedrock | mock
ROVER_EARTH_PROVIDER=ollama
# ollama: an Ollama CLOUD model, default gpt-oss:120b-cloud (run `ollama signin` first; local models are refused).
# bedrock: a Bedrock inference-profile ID enabled in your account (default global.anthropic.claude-haiku-5-5).
ROVER_EARTH_MODEL=gpt-oss:120b-cloud

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# Optional: call Ollama Cloud directly (set OLLAMA_HOST=https://ollama.com)
OLLAMA_API_KEY=

# --- Amazon Bedrock (hackathon demo / benchmark) ---
AWS_REGION=us-east-1
# Demo model: ROVER_EARTH_MODEL=global.anthropic.claude-haiku-5-5. Claude Haiku 5.5 has no in-region
# on-demand endpoint, so it must be called via an inference profile: global.* (any region) or a
# geo profile such as us.anthropic.claude-haiku-5-5 / eu.anthropic.claude-haiku-5-5. Enable model
# access in the Bedrock console first, then verify with `roverthinking check --ping`.
# Standard AWS credentials (env, ~/.aws, or SSO) are used. Optional explicit keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Per-1M-token prices (USD) for cost estimates; look up your model's prices.
BEDROCK_PRICE_IN_PER_M=0
BEDROCK_PRICE_OUT_PER_M=0

# --- Strands Decider 2B (local server) ---
# Start with: strands-decider serve <checkpoint> --port 8099
STRANDS_DECIDER_URL=http://127.0.0.1:8099
ROVER_DECIDER=auto            # auto | server | mock

# --- Game tuning ---
ROVER_CONFIDENCE_THRESHOLD=0.70
ROVER_LIGHT_DELAY_MIN=12      # displayed (simulated) one-way delay, minutes
ROVER_DELAY_REAL_SECONDS=15   # real seconds that delay takes on screen
